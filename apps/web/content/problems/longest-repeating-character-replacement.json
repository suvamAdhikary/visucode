{
  "slug": "longest-repeating-character-replacement",
  "title": "Longest Repeating Character Replacement",
  "difficulty": "Medium",
  "category": "string",
  "patterns": ["sliding-window"],
  "companies": ["Google", "Amazon", "Microsoft"],
  "description": "You are given a string `s` and an integer `k`. You can choose any character of the string and change it to any other uppercase English character. You can perform this operation at most `k` times.\n\nReturn the length of the longest substring containing the same letter you can get after performing the above operations.",
  "examples": [
    {
      "input": "s = \"ABAB\", k = 2",
      "output": "4",
      "explanation": "Replace the two 'A's with two 'B's or vice versa."
    },
    {
      "input": "s = \"AABABBA\", k = 1",
      "output": "4",
      "explanation": "Replace one 'A' in 'AABA' → 'AAAA' or replace one 'B' in 'ABBB' → 'BBBB'."
    }
  ],
  "constraints": [
    "1 <= s.length <= 10^5",
    "s consists of only uppercase English letters",
    "0 <= k <= s.length"
  ],
  "hints": [
    "Use a sliding window and track the frequency of each character inside the window.",
    "The key insight: windowSize - maxFreqInWindow <= k means the window is valid.",
    "If invalid, shrink from the left."
  ],
  "starterCode": {
    "javascript": "function characterReplacement(s, k) {\n  // Your code here\n}"
  },
  "solutions": [
    {
      "language": "javascript",
      "code": "function characterReplacement(s, k) {\n  const count = {};\n  let left = 0, maxFreq = 0, maxLen = 0;\n\n  for (let right = 0; right < s.length; right++) {\n    count[s[right]] = (count[s[right]] || 0) + 1;\n    maxFreq = Math.max(maxFreq, count[s[right]]);\n\n    while ((right - left + 1) - maxFreq > k) {\n      count[s[left]]--;\n      left++;\n    }\n    maxLen = Math.max(maxLen, right - left + 1);\n  }\n  return maxLen;\n}",
      "timeComplexity": "O(n)",
      "spaceComplexity": "O(1)",
      "explanation": "Sliding window tracking character frequencies. Window is valid if (windowSize - maxFreq) <= k. If invalid, shrink left. Track maximum valid window size."
    }
  ],
  "testCases": [
    { "id": "1", "input": "[\"ABAB\", 2]", "expected": "4" },
    { "id": "2", "input": "[\"AABABBA\", 1]", "expected": "4" },
