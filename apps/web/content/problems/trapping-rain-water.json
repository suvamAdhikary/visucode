  "patterns": ["two-pointers"],
  "companies": ["Amazon", "Google", "Goldman Sachs", "Microsoft"],
  "description": "Given `n` non-negative integers representing an elevation map where the width of each bar is `1`, compute how much water it can trap after raining.",
  "examples": [
    {
      "input": "height = [0,1,0,2,1,0,1,3,2,1,2,1]",
      "output": "6",
      "explanation": "The elevation map [0,1,0,2,1,0,1,3,2,1,2,1] can trap 6 units of rain water."
    },
    {
      "input": "height = [4,2,0,3,2,5]",
      "output": "9"
    }
  ],
  "constraints": [
    "n == height.length",
    "1 <= n <= 2 * 10^4",
    "0 <= height[i] <= 10^5"
  ],
  "hints": [
    "Water at any index depends on the min of max-left and max-right heights.",
    "Use two pointers from both ends, tracking leftMax and rightMax.",
    "If height[left] < height[right], process left side; otherwise process right."
  ],
  "starterCode": {
    "javascript": "function trap(height) {\n  // Your code here\n}"
  },
  "solutions": [
    {
      "language": "javascript",
      "code": "function trap(height) {\n  let left = 0, right = height.length - 1;\n  let leftMax = 0, rightMax = 0;\n  let water = 0;\n\n  while (left < right) {\n    if (height[left] < height[right]) {\n      if (height[left] >= leftMax) {\n        leftMax = height[left];\n      } else {\n        water += leftMax - height[left];\n      }\n      left++;\n    } else {\n      if (height[right] >= rightMax) {\n        rightMax = height[right];\n      } else {\n        water += rightMax - height[right];\n      }\n      right--;\n    }\n  }\n  return water;\n}",
      "timeComplexity": "O(n)",
      "spaceComplexity": "O(1)",
      "explanation": "Two pointers from both ends. The side with the smaller height determines the water level. Track leftMax/rightMax — if current height is less than the max, water is trapped."
    }
  ],
  "testCases": [
