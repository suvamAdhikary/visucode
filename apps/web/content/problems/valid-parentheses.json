  ],
  "description": "Given a string `s` containing just the characters `(`, `)`, `{`, `}`, `[` and `]`, determine if the input string is valid.",
  "examples": [
    {
      "input": "s = \"()[]{}\"",
      "output": "true"
    }
  ],
  "constraints": [],
  "hints": [
    "Use a stack to push open brackets."
  ],
  "starterCode": {
    "javascript": "function isValid(s) {\n    // Your code here\n}"
  },
  "solutions": [
    {
      "language": "javascript",
      "code": "function isValid(s) {\n    const stack = [];\n    const map = { \")\": \"(\", \"}\": \"{\", \"]\": \"[\" };\n    for (const char of s) {\n        if (!map[char]) stack.push(char);\n        else if (stack.pop() !== map[char]) return false;\n    }\n    return stack.length === 0;\n}",
      "timeComplexity": "O(N)",
      "spaceComplexity": "O(N)"
    }
  ],
