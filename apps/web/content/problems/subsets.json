  "starterCode": {
    "javascript": "/**\n * @param {number[]} nums\n * @return {number[][]}\n */\nfunction subsets(nums) {\n    // Your code here\n}"
  },
  "solutions": [
    {
      "language": "javascript",
      "timeComplexity": "O(N * 2^N)",
      "spaceComplexity": "O(N)",
      "explanation": "Backtracking / DFS state-space tree traversal. At each step, copy current subset into result, then iterate through remaining choices, push, recurse, and pop.",
      "code": "function subsets(nums) {\n    const result = [];\n    const current = [];\n\n    function backtrack(startIndex) {\n        result.push([...current]);\n\n        for (let i = startIndex; i < nums.length; i++) {\n            current.push(nums[i]);\n            backtrack(i + 1);\n            current.pop();\n        }\n    }\n\n    backtrack(0);\n    return result;\n}"
    }
  ],
