{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "outDir": "./out-tsc/jest",
    "jsx": "preserve",
    "types": ["jest", "node"]
  },
  "include": [
    "jest.config.ts",
    "jest.config.cts",
    "specs/**/*.test.ts",
    "specs/**/*.spec.ts",
    "specs/**/*.test.tsx",
    "specs/**/*.spec.tsx",
    "lib/**/*.test.ts",
    "lib/**/*.spec.ts",
    "app/**/*.test.ts",
    "app/**/*.spec.ts",
    "next-env.d.ts"
  ]
}
