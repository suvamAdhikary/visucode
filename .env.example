# VisuCode Authentication Configuration (Auth.js v5 / NextAuth.js)
# Copy this file to .env.local for local development. Never commit .env.local to Git.

# Secret key for encrypting JWT session cookies (min 32 random characters)
# Generate with: openssl rand -base64 33 or npx auth secret
AUTH_SECRET=development_secret_only_change_in_production_32_characters_minimum

# Application URL
NEXTAUTH_URL=http://localhost:4200
AUTH_URL=http://localhost:4200

# GitHub OAuth 2.0 Credentials
# Create at: https://github.com/settings/developers
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret

# Google OAuth 2.0 Credentials
# Create at: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret
