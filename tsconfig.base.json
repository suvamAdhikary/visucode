{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": [
      "@visucode/source"
    ],
    "paths": {
      "@visucode/shared-types": [
        "libs/shared-types/src/index.ts"
      ],
      "@visucode/visualizer-core": [
        "libs/visualizer-core/src/index.ts"
      ],
      "@visucode/ui-components": [
        "libs/ui-components/src/index.ts"
      ]
    }
  }
}